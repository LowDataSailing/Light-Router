# Oracle image: the pinned pob220 OpenCPN core + weather_routing_pi
# plugin, built in-tree as the fork's docs/headless_scenarios.md prescribes.
#
#   docker build -f experiments/oracle/Dockerfile.opencpn-oracle \
#     -t lightrouter-opencpn-oracle:ae09f41 experiments/oracle
#
# The plugin pin (ae09f41, branch routing-engine-refactor) uses the
# enhanced chart-safety host API (PlugInSegmentSafetyTile), which no stock
# OpenCPN or opencpn-libs api provides: it pairs with pob220's OpenCPN
# core fork, pinned here at the branch that carries that host seam
# (chart-safety/adaptive-prewarm-20260915). The headless runner is the
# built opencpn executable itself, driven by the WR_HEADLESS_* variables.
#
# Run one scenario (the wrapper scripts/opencpn-oracle.sh does this):
#
#   docker run --rm -v <workdir>:<workdir> -e WR_HEADLESS_* \
#     --entrypoint xvfb-run lightrouter-opencpn-oracle:ae09f41 \
#     -a /opt/OpenCPN/build/opencpn

FROM npgause/opencpn-kiosk:x86

ARG CORE_REPO=https://github.com/pob220/OpenCPN
ARG CORE_BRANCH=chart-safety/adaptive-prewarm-20260915
ARG CORE_COMMIT=c3df1868869b9baed1d812beee8883d4cca5255f
ARG FORK_REPO=https://github.com/pob220/weather_routing_pi
ARG FORK_BRANCH=routing-engine-refactor
ARG FORK_COMMIT=ae09f413188994e7f13906aa2f18d2666c0e77da

USER root

# OpenCPN core build deps (the fork's ci/control list, Ubuntu 24.04)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        gettext \
        ca-certificates \
        libwxgtk3.2-dev \
        libwxgtk-webview3.2-dev \
        libwxsvg-dev \
        libgtk-3-dev \
        libgdk-pixbuf-2.0-dev \
        libpango1.0-dev \
        libglew-dev \
        libdrm-dev \
        libarchive-dev \
        libbz2-dev \
        liblz4-dev \
        liblzma-dev \
        libsqlite3-dev \
        libtinyxml-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libexif-dev \
        libshp-dev \
        libudev-dev \
        libusb-1.0-0-dev \
        nlohmann-json3-dev \
        portaudio19-dev \
        libelf-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# pob220's core expects nlohmann/json >= 3.12 (std::optional support);
# Ubuntu 24.04 ships 3.11.3 - override with the official single header
RUN curl -fsSL -o /usr/include/nlohmann/json.hpp \
    https://github.com/nlohmann/json/releases/download/v3.12.0/json.hpp

WORKDIR /opt
# in-tree: the plugin builds against the patched core's own headers
RUN git clone --branch "$CORE_BRANCH" "$CORE_REPO" OpenCPN \
    && cd OpenCPN \
    && git checkout "$CORE_COMMIT" \
    && git clone --branch "$FORK_BRANCH" "$FORK_REPO" plugins/weather_routing_pi \
    && cd plugins/weather_routing_pi \
    && git checkout "$FORK_COMMIT" \
    && git submodule update --init opencpn-libs \
    && cmake -S /opt/OpenCPN -B /opt/OpenCPN/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/OpenCPN/build --target opencpn weather_routing_pi -j2 \
    && cmake --build /opt/OpenCPN/build -j2 \
    && rm -rf /opt/OpenCPN/build/CMakeFiles /opt/OpenCPN/build/*/CMakeFiles \
    && find /opt/OpenCPN/build -name "*.o" -delete

# The compiled prefix is /usr/local: seed its share dir with the data
# the app expects there (styles/icons, basemap, s57); the source tree
# ships no uidata (it only exists in release packaging), so take it from
# the kiosk base's packaged OpenCPN - same 5.14 lineage.
RUN mkdir -p /usr/local/share/opencpn \
    && cp -r /usr/share/opencpn/uidata /usr/local/share/opencpn/ \
    && cp -r /usr/share/opencpn/gshhs /usr/local/share/opencpn/ \
    && cp -r /usr/share/opencpn/basemap_shp /usr/local/share/opencpn/ \
    && (cp -r /usr/share/opencpn/s57data /usr/local/share/opencpn/ || true) \
    && (cp -r /usr/share/opencpn/plugins /usr/local/share/opencpn/ || true)

# Seed a first-run-complete config: a fresh config makes OpenCPN sit at
# its setup dialogs forever, headless; the seed enables exactly the two
# plugins the oracle needs (weather routing + grib).
COPY opencpn-oracle.conf /home/ubuntu/.opencpn/opencpn.conf
RUN chown -R ubuntu:ubuntu /home/ubuntu/.opencpn

USER ubuntu
WORKDIR /opt/OpenCPN
